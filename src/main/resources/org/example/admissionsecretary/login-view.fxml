<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.admissionsecretary.LoginController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Вход для администратора" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Логин"/>
    <TextField fx:id="usernameField" promptText="admin"/>

    <Label text="Пароль"/>
    <PasswordField fx:id="passwordField"/>

    <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>

    <Button text="Войти" onAction="#login" maxWidth="Infinity"/>
</VBox>