<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.admissionsecretary.StatusController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Проверить статус заявления" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Введите ваш Email"/>
    <TextField fx:id="emailField" promptText="example@mail.ru" maxWidth="300"/>

    <Label text="Выберите специальность"/>
    <ComboBox fx:id="listComboBox" maxWidth="300"/>

    <Button text="Проверить" onAction="#checkStatus" maxWidth="300"/>

    <Label fx:id="resultLabel" style="-fx-font-size: 14px;" wrapText="true"/>
</VBox>